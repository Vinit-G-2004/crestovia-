# These are added automatically once you create a Postgres database
# from the Storage tab in your Vercel project (Vercel Postgres / Neon).
# You don't need to fill these in by hand on Vercel.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# The admin account used the very first time the app creates its data.
# After the first login you can change both from Settings inside the app,
# so it's fine to leave these as-is or change them before first deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Crestovia@2026

# Used to sign the login session cookie. Set this to a long random string
# before deploying to production (e.g. run: openssl rand -hex 32).
AUTH_SECRET=change-this-to-a-long-random-string
